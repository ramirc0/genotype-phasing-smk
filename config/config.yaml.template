# Copy to config/<run_id>/config.yaml, with exclude_samples.tsv beside it.
outdir: results
pixi_env: default
run_id: <run_id>         # YYYY-MM-DD-<what>; names results/, logs/ and benchmarks/ subdirs

callset: /path/to/callset.vcf.gz
fasta: /data/zusers/ramirezc/joint-genotyping-smk/resources/GRCh38_no_alt_analysis_set_GCA_000001405.15.fasta
exclude_samples: config/<run_id>/exclude_samples.tsv
chromosomes: [chr1, chr2, chr3, chr4, chr5, chr6, chr7, chr8, chr9, chr10, chr11,
              chr12, chr13, chr14, chr15, chr16, chr17, chr18, chr19, chr20, chr21, chr22]
                         # add chrX to phase it too; it needs phaser: shapeit5

phaser: shapeit5         # or eagle2
panel: /data/zusers/ramirezc/data/genotype-phasing-smk/resources/hgdp1kgp/{region}.bcf
genetic_maps:
  shapeit5: /data/zusers/ramirezc/data/genotype-phasing-smk/resources/genetic-maps/shapeit5/{region}.b38.gmap.gz
  eagle2: /data/zusers/ramirezc/data/genotype-phasing-smk/resources/genetic-maps/eagle2/genetic_map_hg38_withX.txt.gz

array_manifest: /data/zusers/ramirezc/data/genotype-phasing-smk/resources/mega/Multi-EthnicGlobal_D2.csv
long_range_ld: /data/zusers/ramirezc/data/genotype-phasing-smk/resources/high-LD-regions-hg38-GRCh38.bed
kinship_cutoff: 0.0442   # KING kinship at the third-degree bound
num_pcs: 20

panel_metadata: /data/zusers/ramirezc/data/genotype-phasing-smk/resources/hgdp1kgp/gnomad_meta_updated.tsv
local_ancestry:
  tool: rfmix2           # or gnomix
  # gnomix_config: <path>   # gnomix base config; defaults to its configs/config_array.yaml
  populations:           # panel populations whose unrelated samples may enter the reference
    AFR: [YRI, ESN, GWD, MSL, LWK, Yoruba, Mandenka]
    EUR: [CEU, GBR, IBS, TSI, French, Italian, Tuscan, Basque, Orcadian, Sardinian, Russian]
    NAT: [PEL, MXL, Maya, Pima, Karitiana, Surui, Colombian]
  min_purity: {AFR: 0.9, EUR: 0.9, NAT: 0.8}   # smallest ADMIXTURE share to join the reference
  rfmix_generations: 8   # RFMix2 -G, generations since admixture
seed: 1

filters:
  min_dp: 10             # genotypes below this depth go missing
  min_maf: 0.01
  max_missing: 0.05      # largest missing genotype fraction per site
