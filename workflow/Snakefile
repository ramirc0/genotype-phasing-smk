# The pixi plugin installs the env inside each job. Parallel SLURM jobs then race
# on a fresh or relocked env, so install it once before any job starts.
onstart:
    shell("pixi install --manifest-path {workflow.basedir:q}/envs/pixi.toml --all --locked")


rule all:
    input:
        expand(f"{OUTDIR}/phased/{{chrom}}.vcf.gz", chrom=CHROMOSOMES),
        expand(f"{OUTDIR}/pgen/{{chrom}}.pgen", chrom=CHROMOSOMES),
        f"{OUTDIR}/king.kin0",
        f"{OUTDIR}/pcs.tsv",
        f"{OUTDIR}/local_ancestry_global.tsv",
        expand(
            f"{OUTDIR}/plots/{{plot}}.png",
            plot=["karyograms", "ideograms", "global_ancestry"],
        ),
        expand(f"{OUTDIR}/tracts/{{chrom}}.anc0.dosage.txt.gz", chrom=PHASED_AUTOSOMES),
        f"{OUTDIR}/config.snapshot.json",
